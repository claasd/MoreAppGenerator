<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <LangVersion>14</LangVersion>
        <RootNamespace>MoreAppBuilder</RootNamespace>
        <IsPackable>true</IsPackable>
        <RepositoryUrl>https://github.com/claasd/MoreAppGenerator.git</RepositoryUrl>
        <Authors>claasd</Authors>
        <PackageLicenseExpression>MIT</PackageLicenseExpression>
        <Description>Fluent generator for MoreApp.</Description>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="CdIts.Caffoa.Json.Net" Version="5.4.1" />
        <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="5.12.0" />
        <PackageReference Include="YamlDotNet" Version="18.1.0"/>
    </ItemGroup>

    <ItemGroup>
        <Content Include="..\caffoa.yml">
            <Link>api\caffoa.yml</Link>
        </Content>
    </ItemGroup>

</Project>
